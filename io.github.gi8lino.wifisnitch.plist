<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.gi8lino.wifisnitch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/WiFiSnitch.app/Contents/MacOS/WiFiSnitch</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/io.github.gi8lino.wifisnitch.out</string>

  <key>StandardErrorPath</key>
  <string>/tmp/io.github.gi8lino.wifisnitch.err</string>
</dict>
</plist>
